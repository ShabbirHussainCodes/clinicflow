# ClinicFlow environment variables.
#
# Copy to .env.local for local development (`npm run env:local` fills in the Supabase values
# for you), and set the same names in your hosting provider's dashboard (for example Render).
# Never commit real values: .env* files are git-ignored except this example.
#
# None of these are exposed to the browser. The browser never talks to Supabase directly, so no
# NEXT_PUBLIC_ variables are needed, and values are read at runtime (no rebuild when they change).

# --- Supabase (required) ----------------------------------------------------------------------
# Project URL. Local stack: http://127.0.0.1:54321. Hosted: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# The project's anon / publishable key. Safe to hold server-side; row level security protects data.
SUPABASE_ANON_KEY=

# --- Supabase service role (optional, server-only) ---------------------------------------------
# Needed ONLY for (a) `npm run admin:create` and (b) the automation dispatcher endpoint.
# It bypasses row level security: keep it secret and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------------------------
# Public URL of the deployed site (used for canonical links, sitemap and robots).
SITE_URL=http://localhost:3000
# Shows the "demonstration site" strip. Set to false for a real clinic deployment.
SHOW_DEMO_NOTICE=true

# --- Abuse protection (optional; defaults shown) ------------------------------------------------
# Booking submissions allowed per client address per hour.
BOOKING_RATE_LIMIT_PER_HOUR=8
# Sign-in attempts allowed per e-mail address per 15 minutes (per-address limit is 4x this).
LOGIN_ATTEMPTS_PER_15_MIN=6

# --- Automation / n8n (all optional; the application works fully without them) ------------------
# The dispatcher endpoint (/api/cron/dispatch-events) stays disabled (HTTP 503) until
# SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET and N8N_WEBHOOK_URL are ALL set.
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" (16+ characters).
CRON_SECRET=
# Webhook URL events are POSTed to (for example an n8n Webhook node production URL).
N8N_WEBHOOK_URL=
# Shared secret used to sign each delivery (HMAC-SHA256). 16+ characters. Defaults to CRON_SECRET.
N8N_WEBHOOK_SECRET=
# Optional static token sent as the X-ClinicFlow-Token header, for receivers that can only check a
# fixed header (for example n8n's built-in Header Auth). The HMAC signature is still sent. 16+ chars.
N8N_WEBHOOK_AUTH_TOKEN=
# Delivered events contain patient contact details; they are deleted after this many days.
EVENT_RETENTION_DAYS=30
# How many hours before an appointment the reminder_due event is queued.
EVENT_REMINDER_LEAD_HOURS=24
